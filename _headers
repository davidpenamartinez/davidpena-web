# Cabeceras que aplica Cloudflare Pages a las respuestas.
# Este archivo NO se sirve al visitante: Pages lo lee al desplegar.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# El CSS se revalida en cada visita: así un push se ve al recargar,
# sin tener que hacer hard-refresh. Clave para editar en vivo.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Las imágenes casi no cambian: se cachean un día.
/img/*
  Cache-Control: public, max-age=86400
